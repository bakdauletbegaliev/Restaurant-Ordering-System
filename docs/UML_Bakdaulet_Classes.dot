
digraph UML {
 graph [label="BAKDAULET | CLASS DIAGRAM | Factory Method + Decorator + Builder",labelloc=t,fontsize=20,fontname="DejaVu Sans",bgcolor=white,rankdir=LR,nodesep=0.3,ranksep=0.65,pad=0.25,splines=polyline]
 node [shape=record,style="rounded,filled",fontname="DejaVu Sans",fontsize=11,color="#537b9c",fillcolor="#eef5fa",margin="0.12,0.09"]
 edge [fontname="DejaVu Sans",fontsize=9,color="#6b7b91",arrowsize=0.75]
 Meal [label="{«interface» Meal|+ getDescription(): String\l+ getPrice(): int\l}"]
 BasicMeal [label="{BasicMeal|+ BasicMeal(name, price)\l+ getPrice(): int\l}"]
 MealFactory [label="{«abstract» MealFactory|+ createMeal(): Meal\l}",fillcolor="#f5f3ff",color="#8779ba"]
 PizzaFactory [label="{PizzaFactory|+ createMeal(): Meal\l}"]
 BurgerFactory [label="{BurgerFactory|+ createMeal(): Meal\l}"]
 SaladFactory [label="{SaladFactory|+ createMeal(): Meal\l}"]
 MealDecorator [label="{«abstract» MealDecorator|# wrapped: Meal\l}",fillcolor="#f5f3ff",color="#8779ba"]
 CheeseDecorator [label="{CheeseDecorator|+ getPrice(): int\l}"]
 SauceDecorator [label="{SauceDecorator|+ getPrice(): int\l}"]
 OlivesDecorator [label="{OlivesDecorator|+ getPrice(): int\l}"]
 Order [label="{Order| - meals: List«Meal»\l+ getSubtotal(): int\l}",fillcolor="#e8f7ee",color="#419b75"]
 Builder [label="{Order.Builder|+ addMeal(Meal): Builder\l+ build(): Order\l}",fillcolor="#e8f7ee",color="#419b75"]
 BasicMeal -> Meal [style=dashed,arrowhead=empty]
 MealDecorator -> Meal [style=dashed,arrowhead=empty]
 MealDecorator -> Meal [label="wraps",arrowhead=diamond,style=solid,penwidth=0.9,constraint=false]
 PizzaFactory -> MealFactory [arrowhead=empty]
 BurgerFactory -> MealFactory [arrowhead=empty]
 SaladFactory -> MealFactory [arrowhead=empty]
 CheeseDecorator -> MealDecorator [arrowhead=empty]
 SauceDecorator -> MealDecorator [arrowhead=empty]
 OlivesDecorator -> MealDecorator [arrowhead=empty]
 MealFactory -> Meal [style=dashed,label="creates"]
 Builder -> Order [label="builds"]
 Order -> Meal [label="contains 1..*",arrowhead=odiamond]
}