
digraph UML {
 graph [label="DIAS | CLASS DIAGRAM | Observer + Strategy + Facade",labelloc=t,fontsize=20,fontname="DejaVu Sans",bgcolor=white,rankdir=LR,nodesep=0.35,ranksep=0.8,pad=0.25,splines=polyline]
 node [shape=record,style="rounded,filled",fontname="DejaVu Sans",fontsize=11,color="#537b9c",fillcolor="#eef5fa",margin="0.14,0.10"]
 edge [fontname="DejaVu Sans",fontsize=9,color="#6b7b91",arrowsize=0.78]
 Facade [label="{RestaurantFacade|+ placeOrder(...): OrderSummary\l+ advanceOrder(id): OrderSummary\l}",fillcolor="#eaf8ef",color="#498c6d"]
 Observer [label="{«interface» OrderObserver|+ onStatusChanged(Order, Status)\l}",fillcolor="#fff6e7",color="#be8f3e"]
 Tracker [label="{OrderTracker| - subscribers: List«OrderObserver»\l+ subscribe(listener)\l+ changeStatus(status)\l}"]
 Kitchen [label="{KitchenObserver|+ onStatusChanged(... )\l}"]
 Customer [label="{CustomerObserver|+ onStatusChanged(... )\l}"]
 Strategy [label="{«interface» DiscountStrategy|+ calculateDiscount(subtotal): int\l}",fillcolor="#fff6e7",color="#be8f3e"]
 Checkout [label="{Checkout| - discountStrategy: DiscountStrategy\l+ calculate(Order): PriceSummary\l}"]
 Regular [label="{NoDiscount|+ calculateDiscount(...)\l}"]
 Student [label="{StudentDiscount|+ calculateDiscount(...)\l}"]
 Loyalty [label="{LoyaltyDiscount|+ calculateDiscount(...)\l}"]
 Kitchen -> Observer [style=dashed,arrowhead=empty]
 Customer -> Observer [style=dashed,arrowhead=empty]
 Tracker -> Observer [label="notifies 0..*",arrowhead=odiamond]
 Regular -> Strategy [style=dashed,arrowhead=empty]
 Student -> Strategy [style=dashed,arrowhead=empty]
 Loyalty -> Strategy [style=dashed,arrowhead=empty]
 Checkout -> Strategy [label="uses",arrowhead=odiamond]
 Facade -> Checkout [label="calculates"]
 Facade -> Tracker [label="tracks"]
}